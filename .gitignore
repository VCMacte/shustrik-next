node_modules/
dist/
# Самоподписанный сертификат для раздачи dist/ по HTTPS в локальной сети
# (docs/spike.md). Ключ — на одну машину и один выезд, в репозиторий ему
# дороги нет.
.cert/
.DS_Store
Thumbs.db
*.log
.playwright-mcp/
.superpowers/
.tmp/

# Журналы с телефона лежат локально: репозиторий публичный, а это записи
# о ребёнке. То же правило, что в run-game. Папка и README остаются.
logs/*
!logs/README.md

# Замеры бюджета кадра — числа одной машины и одного дня, а не история для
# публичного репозитория. Папка и README остаются по тому же правилу.
measurements/*
!measurements/README.md

# Промежуточное арта: то, что вернула нейросеть, и запечённые атласы.
# В приложение уходит только assets/*.glb и сжатые текстуры.
tools/baked/
tools/raw/
