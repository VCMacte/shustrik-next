# src/core — побайтовые копии логики из run-game (tools/sync-logic.mjs,
# logic.manifest.json). Git на Windows по умолчанию может переводить
# переводы строк при checkout/commit (core.autocrlf), а здесь хеш в манифесте
# обязан совпадать с хешем файла что в git, что на диске — любая такая
# трансформация тихо ломает byte-identity независимо от локальной настройки
# автора. `-text` выключает её для этих файлов безусловно.
src/core/*.js -text
